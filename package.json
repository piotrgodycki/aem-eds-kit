{
  "name": "aem-eds-kit",
  "version": "0.4.73",
  "description": "The agent harness for AEM Edge Delivery Services: your AI agent turns Figma, Framer or Google Stitch designs into blocks, inside guardrails; plus AEM component migration (AEMaaCS and 6.5), Universal Editor models and QA",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "eds": "dist/bin/eds.js"
  },
  "files": [
    "dist",
    "samples",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx src/bin/eds.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "aem",
    "edge-delivery-services",
    "helix",
    "figma",
    "mcp",
    "cli",
    "adobe",
    "aem-edge-delivery",
    "universal-editor",
    "aemaacs",
    "aem-migration",
    "framer",
    "google-stitch",
    "design-to-code",
    "claude-code"
  ],
  "author": "Piotr Godycki <piotrgodycki@yahoo.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piotrgodycki/aem-eds-kit.git"
  },
  "homepage": "https://piotrgodycki.github.io/aem-eds-kit/",
  "bugs": {
    "url": "https://github.com/piotrgodycki/aem-eds-kit/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "execa": "^9.5.0",
    "fast-xml-parser": "^5.11.2",
    "ora": "^8.1.0",
    "yaml": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^22.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
