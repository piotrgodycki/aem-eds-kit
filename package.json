{
  "name": "aem-eds-cli",
  "version": "0.2.0",
  "description": "CLI for AEM Edge Delivery Services with Figma MCP integration",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "eds": "./dist/bin/eds.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/bin/eds.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "aem",
    "edge-delivery-services",
    "helix",
    "figma",
    "mcp",
    "cli",
    "adobe"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "execa": "^9.5.0",
    "ora": "^8.1.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
